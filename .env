# DevPulse Switch Console Configuration Template
# Copy this file to .env and configure for your local or remote Switch Core instance.

# Switch Core Server URL
SWITCH_CORE_URL=http://localhost:8080

# Switch Agent Credentials (distinct agent identities)
SWITCH_AGENT_ID=agn_devpulse_sentinel
SWITCH_SENTINEL_AGENT_ID=agn_devpulse_sentinel
SWITCH_RUNNER_AGENT_ID=agn_devpulse_runner
SWITCH_AGENT_API_KEY=sw_key_placeholder_do_not_commit

# Switch Room ID to claim and monitor
SWITCH_ROOM_ID=room_devpulse_operations

# Maintainer User IDs authorized for approval commands (comma-separated native Switch IDs)
# Example: usr_alice_maintainer,usr_bob_security
MAINTAINER_ALLOWLIST=usr_maintainer_lead

# Internal Server HMAC Secret (min 32 characters, used for audit chaining and internal token integrity)
DEVPULSE_APPROVAL_SECRET=replace_with_a_secure_random_key_of_at_least_32_characters_length

# File Storage Paths
AUDIT_LOG_PATH=./logs/audit.jsonl
INCIDENT_STORE_PATH=./data/incidents.md
CHALLENGE_STORE_PATH=./data/approval-challenges.jsonl

# Environment Mode
NODE_ENV=development

{
  "name": "devpulse",
  "version": "0.1.0",
  "description": "Autonomous PR and thread engagement engine for Switch Console with persistent incident memory and HITL governance",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:ui": "vite build",
    "preview": "vite preview",
    "build": "tsc",
    "test": "node --import tsx --test tests/**/*.test.ts",
    "typecheck": "tsc --noEmit",
    "gate:register": "tsx src/gate/register.ts",
    "gate": "tsx src/gate/index.ts",
    "dashboard": "node --import tsx scripts/dashboard-server.ts",
    "demo:audit": "node --import tsx scripts/demo-audit.ts"
  },
  "keywords": [
    "switch-console",
    "ai-agent",
    "pull-request",
    "security",
    "hitl",
    "incident-response"
  ],
  "author": "DevPulse Team",
  "license": "Apache-2.0",
  "dependencies": {
    "framer-motion": "^14.9.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ws": "^8.22.1",
    "zod": "^3.24.2",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@types/node": "^22.13.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.2.1",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vite": "^8.3.6"
  }
}
